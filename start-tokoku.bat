@echo off
title TokoKu
echo [TokoKu] Starting...
start /min "TokoKu-Backend" cmd /c "cd /d C:\Users\ALASKAID\tokoku\backend && node src/server.js >> logs\app.log 2>&1"
start /min "TokoKu-Frontend" cmd /c "cd /d C:\Users\ALASKAID\tokoku\frontend && npx vite --host 0.0.0.0 --port 5173 >> ..\backend\logs\app.log 2>&1"
echo [TokoKu] Backend :3001 (0.0.0.0) + Frontend :5173 (0.0.0.0) starting...
timeout /t 5 >nul
curl -s http://localhost:3001/api/health >nul && echo [TokoKu] Backend OK || echo [TokoKu] Backend belum siap, tunggu sebentar...
curl -s http://localhost:5173/ >nul && echo [TokoKu] Frontend OK || echo [TokoKu] Frontend belum siap...
echo [TokoKu] Buka http://localhost:5173 atau http://192.168.1.12:5173 di HP (1 WiFi)
